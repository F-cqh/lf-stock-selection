# 统一换行符处理，避免 Windows / Linux 之间产生「整文件都改了」的无意义 diff
* text=auto

# 明确指定文本类型（防止被误判成二进制）
*.py    text
*.md    text
*.txt   text
*.toml  text
*.cfg   text
*.ini   text
*.json  text
*.yaml  text
*.yml   text

# 二进制：不做任何转换
*.parquet  binary
*.feather  binary
*.h5       binary
*.hdf5     binary
*.pkl      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.pdf      binary
*.xlsx     binary
